{
  "manifest_version": 3,
  "name": "Análise de Representatividade",
  "version": "1.0",
  "description": "Uma extensão que analisa a representatividade de personalidades negras e indígenas em páginas web.",

  "permissions": ["activeTab", "scripting", "storage", "tabs"],

  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["banco-de-dados.js", "content.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "icons": {
    "48": "icon.png",
    "128": "128.png"
  }
}
